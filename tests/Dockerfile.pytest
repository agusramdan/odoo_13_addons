# FROM python:3.7.3-slim@sha256:baf4188f0b50c6383fedd55cdb79f511bfabee23068dcf26f209426f4bf540ab
FROM odoo:13.0@sha256:487514270bff6f4a37cfb7532a2f513cfca7ea4ce996f628c6d9edd4502be2a6

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/pytest-packages

WORKDIR /workspace
COPY requirements-pytest.txt /tmp/pytest-requirements.txt

USER root
RUN python3 -m pip install --no-cache-dir --upgrade pip==23.3.2 \
    && python3 -m pip install --no-cache-dir --target /opt/pytest-packages -r /tmp/pytest-requirements.txt
USER odoo

# Mount the licensed Hermes test skill read-only at /skill when running.
ENTRYPOINT ["python3", "-B", "/skill/scripts/run_tests.py"]
