FROM python:3.8.20-slim-bookworm@sha256:1d52838af602b4b5a831beb13a0e4d073280665ea7be7f69ce2382f29c5a613f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace
COPY requirements-pytest.txt /tmp/pytest-requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip==23.3.2 \
    && python -m pip install --no-cache-dir -r /tmp/pytest-requirements.txt

# Mount the licensed Hermes test skill read-only at /skill when running.
ENTRYPOINT ["python", "-B", "/skill/scripts/run_tests.py"]
