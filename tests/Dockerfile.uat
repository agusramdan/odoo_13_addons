# UAT runner scaffold only; runtime is deliberately pinned and checked.
# Repository sources and dependency resolution are deliberately not copied or run here.
ARG UAT_BASE_IMAGE=python:3.8.20-slim-bookworm@sha256:1d52838af6022b4b5a831beb13a0e4d073280665ea7be7f69ce2382f29c5a613f
FROM ${UAT_BASE_IMAGE}

ARG UAT_PYTHON_RUNTIME=3.8.20
ARG UAT_DEPENDENCY_SET
LABEL org.opencontainers.image.description="Isolated, parameterized UAT runner scaffold" \
      org.example.uat.python-runtime="${UAT_PYTHON_RUNTIME}" \
      org.example.uat.dependency-set="${UAT_DEPENDENCY_SET}"

WORKDIR /workspace

# Fail closed when the runtime reconciliation inputs are omitted. This check is
# local to the image build; it performs no network, package, or service action.
RUN test "${UAT_PYTHON_RUNTIME}" = "3.8.20" \
    && test -n "${UAT_DEPENDENCY_SET}" \
    && case "${UAT_BASE_IMAGE}" in *@sha256:*) ;; *) echo 'UAT_BASE_IMAGE must be digest-pinned' >&2; exit 1 ;; esac \
    && python -c 'import sys; assert sys.version_info[:3] == (3, 8, 20), sys.version'

# No default test command: each task must provide its explicitly authorized
# bounded command through the UAT profile. Compose keeps this image dormant by
# default and supplies no implicit database, credentials, or network access.
CMD ["/bin/sh", "-c", "echo 'UAT command not configured; provide task-approved command.' >&2; exit 64"]
