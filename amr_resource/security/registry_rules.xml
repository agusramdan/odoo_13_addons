<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <!-- Global rules intersect every role's ACL; one effective company, not all allowed companies. -->
    <record id="rule_oidc_issuer_company" model="ir.rule">
        <field name="name">Trust issuer: effective company</field>
        <field name="model_id" ref="model_amr_resource_issuer"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_oidc_audience_company" model="ir.rule">
        <field name="name">Trust audience: effective company</field>
        <field name="model_id" ref="model_amr_resource_audience"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
    <record id="rule_oidc_binding_company" model="ir.rule">
        <field name="name">Trust binding: effective company</field>
        <field name="model_id" ref="model_amr_resource_binding"/>
        <field name="domain_force">[('company_id', '=', company_id)]</field>
    </record>
</data></odoo>
