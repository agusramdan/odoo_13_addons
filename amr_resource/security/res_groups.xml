<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <!-- No users or implied groups: membership is assigned manually. -->
        <record id="group_oidc_trust_admin" model="res.groups">
            <field name="name">OIDC Trust Administrator</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        <record id="group_oidc_code_admin" model="res.groups">
            <field name="name">OIDC Source Administrator (execution disabled)</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        <record id="group_machine" model="res.groups">
            <field name="name">Machine/Client/Service User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="users" eval="[(4, ref('base.user_root'))]" />
        </record>

        <record id="group_technical" model="res.groups">
            <field name="name">Technical User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
        </record>

        <record id="user_machine_template" model="res.users">
            <field name="name">Machine User</field>
            <field name="login">machine_user</field>
            <field name="email">machine@system.local</field>

            <!-- penting: non-share = internal system user -->
            <field name="share" eval="False"/>
            <field name="active" eval="False"/>
            <!-- assign group machine -->
            <field name="groups_id" eval="[(4, ref('amr_resource.group_machine'))]"/>
        </record>
    </data>
</odoo>
