<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_service_credential_wizard_form_profile" model="ir.ui.view">
            <field name="name">service.credential.wizard.form.profile</field>
            <field name="model">service.credential.wizard</field>
            <field name="inherit_id" ref="amr_service_client.view_service_credential_wizard_form"/>
            <field name="arch" type="xml">
                <field name="token_uri" position="before">
                    <field name="issuer_profile_id" groups="amr_resource.group_oidc_trust_admin" options="{'no_create': True}" attrs="{'invisible':[('credential_type','not in',['service_account','client_secret'])]}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
