FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

# 1. Install tool dasar dev, git, ssh, dan postgresql-client (psql)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    openssh-client \
    postgresql-client \
    ripgrep \
    sudo \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# 2. Ambil binary uv dan docker-cli secara ringan (tanpa install Docker daemon)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

# 3. Buat user non-root 'dev' (UID/GID 1000) agar sinkron dengan kontainer Odoo
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Siapkan direktori workspace dan persistensi memory Hermes
RUN mkdir -p /workspace /home/${USERNAME}/.hermes \
    && chown -R ${USER_UID}:${USER_GID} /workspace /home/${USERNAME}/.hermes

# 4. Beralih ke user dev & install Hermes Agent via uv
USER ${USERNAME}
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

RUN uv tool install --python 3.11 git+https://github.com/NousResearch/hermes-agent.git

WORKDIR /workspace

CMD ["sleep", "infinity"]
