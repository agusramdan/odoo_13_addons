{
  "name": "Odoo Custom + Hermes Workspace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "hermes",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",

  "containerEnv": {
    "DEV_USER": "${localEnv:USER}",
    "DEVPOD_WORKSPACE_ID": "${localEnv:DEVPOD_WORKSPACE_ID}"
  },

  "forwardPorts": [
    "odoo:8069",
    "odoo:5678"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-xml",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/dev/hermes-agent/.venv/bin/python"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo chmod 666 /var/run/docker.sock 2>/dev/null || true",

  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OPENAI_BASE_URL": "${localEnv:OPENAI_BASE_URL}",
    "MODEL_REASONING": "${localEnv:MODEL_REASONING}",
    "MODEL_CODER": "${localEnv:MODEL_CODER}"
  }
}