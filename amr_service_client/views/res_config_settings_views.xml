<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.service.client.sentry</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Service Client" string="Service Client"
                         data-key="amr_service_client" groups="base.group_system">
                        <h2>Service Client Sentry</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="amr_service_client_sentry_mode"/>
                                    <field name="amr_service_client_sentry_mode"/>
                                    <div class="text-muted">All reports successes and errors for service.client and service.client.log. Error reports failures only. Selected reports failures for opted-in clients only. None disables reporting. Install/configure sentry-sdk at deployment; this addon does not initialize a DSN.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
