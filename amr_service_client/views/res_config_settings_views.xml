<odoo>
    <data>
        <record id="res_config_settings_view_form_service_client" model="ir.ui.view">
            <field name="name">res.config.settings.service.client</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Service Client" string="Service Client">
                        <h2>Service Client</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="service_client_sentry_mode"/>
                                    <div class="text-muted">Configure sanitized Sentry reporting for outbound calls.</div>
                                    <field name="service_client_sentry_mode"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
